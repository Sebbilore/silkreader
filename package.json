{
  "name": "silkreader",
  "productName": "Silkreader",
  "version": "1.21.0",
  "description": "Silkreader – eine schwebende Spinne, die Texte und Dokumente mit KI liest, zusammenfasst und analysiert",
  "main": "src/main.js",
  "author": "Silkreader",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage",
    "dist:win:linux": "electron-builder --win nsis --x64 --publish never -c.win.signtoolOptions.sign=./build/sign.js",
    "dist:store": "electron-builder --win appx --config electron-builder.store.js --publish never",
    "notices": "node scripts/notices.mjs"
  },
  "build": {
    "appId": "app.silkreader",
    "productName": "Silkreader",
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/@node-llama-cpp/*-cuda*/**",
      "!node_modules/@node-llama-cpp/*arm*/**",
      "!node_modules/node-llama-cpp/llama/**/*.{h,c,cpp,hpp,cu,cuh,txt,md}",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/vendor/**",
      "!node_modules/**/*.{md,markdown,map,d.ts,d.mts,d.cts}",
      "!node_modules/**/{test,tests,__tests__,example,examples,.github}/**",
      "!node_modules/**/{CHANGELOG,HISTORY,AUTHORS,CONTRIBUTING}*"
    ],
    "icon": "build/icon.png",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Silkreader",
      "runAfterFinish": true,
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "artifactName": "Silkreader-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Sebbilore",
        "repo": "silkreader-download",
        "releaseType": "release"
      }
    ],
    "copyright": "© 2026 Silkreader",
    "win": {
      "signtoolOptions": {
        "publisherName": [
          "CN=Silkreader, O=Silkreader"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ]
      },
      "legalTrademarks": "Silkreader"
    },
    "asarUnpack": [
      "node_modules/node-llama-cpp/**",
      "node_modules/@node-llama-cpp/**",
      "node_modules/koffi/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "electron-updater": "^6.8.9",
    "koffi": "2.16.3",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.1",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sebbilore/silkreader.git"
  }
}
